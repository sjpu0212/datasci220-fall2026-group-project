knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(ggplot2)
data <- mtcars
data$cyl <- factor(data$cyl)  # make cyl categorical
head(data)
ggplot(data,
aes(x = wt, y = mpg)) +
geom_point() +
labs(title = "Scatterplot of MPG vs. Weight",
x = "Weight (1000 lbs)",
y = "Miles per Gallon (mpg)")
model1 <- lm(mpg ~ wt, data = data)
summary(model1)
ggplot(data, aes(x = wt, y = mpg)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(title = "Least Squares Regression Line for MPG vs Weight")
new_data <- data.frame(wt = c(2.0, 3.0, 4.0, 5.0))
predictions <- predict(model1, newdata = new_data)
cbind(new_data, Predicted_MPG = predictions)
model2 <- lm(mpg ~ wt + hp, data = data)
summary(model2)
mean_hp <- mean(data$hp)
grid <- data.frame(
wt = seq(min(data$wt), max(data$wt), length.out = 50),
hp = mean_hp
)
grid$pred <- predict(model2, newdata = grid)
ggplot(data, aes(x = wt, y = mpg)) +
geom_point() +
geom_line(data = grid, aes(x = wt, y = pred), color = "red", size = 1) +
labs(title = "Multiple Regression: Effect of Weight on MPG (HP held constant)")
model3 <- lm(mpg ~ wt + cyl, data = data)
summary(model3)
grid_parallel <- expand.grid(
wt = seq(min(data$wt), max(data$wt), length.out = 50),
cyl = levels(data$cyl)
)
grid_parallel$mpg_pred <- predict(model3, newdata = grid_parallel)
ggplot(data, aes(x = wt, y = mpg, color = cyl)) +
geom_point() +
geom_line(data = grid_parallel, aes(y = mpg_pred, color = cyl), size = 1) +
labs(title = "Parallel Lines Model (Additive Effect of Cylinder Count)",
x = "Weight (1000 lbs)", y = "MPG") +
theme_minimal()
model4 <- lm(mpg ~ wt * cyl, data = data)
summary(model4)
ggplot(data, aes(x = wt, y = mpg, color = cyl)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "Non-Parallel Lines: Interaction Between Weight and Cylinders",
x = "Weight (1000 lbs)", y = "MPG")
house_sales <- read.csv("kc_house_data.csv")
str(house_sales)
simple_linear <- lm(price ~ sqft_living, data = house_sales)
summary(simple_linear)
ggplot(house_sales, aes(x = sqft_living, y = price)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(title = "Least Squares Regression Line for price vs sqft_living")
linear_2 <- lm(price ~ sqft_living + sqft_lot, data = house_sales)
summary(linear_2)
house_sales$waterfront <- factor(house_sales$waterfront)  # make waterfront categorical
linear_3 <- lm(price ~ sqft_living + waterfront, data = house_sales)
summary(linear_3)
grid_parallel <- expand.grid(
sqft_living = seq(min(house_sales$sqft_living), max(house_sales$sqft_living), length.out = 50),
waterfront = levels(house_sales$waterfront)
)
grid_parallel$price_pred <- predict(linear_3, newdata = grid_parallel)
ggplot(house_sales, aes(x = sqft_living, y = price, color = waterfront)) +
geom_point() +
geom_line(data = grid_parallel, aes(y = price_pred, color = waterfront), size = 1) +
labs(title = "Parallel Lines Model (Additive Effect of waterfront)",
x = "sqft_living", y = "price") +
theme_minimal()
linear_4 <- lm(price ~ sqft_living * waterfront, data = house_sales)
summary(linear_4)
ggplot(house_sales, aes(x = sqft_living, y = price, color = waterfront)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "Non-Parallel Lines: Interaction Between price and sqft_living",
x = "sqft_living", y = "price")
